# 云枢 OpsMind 环境变量示例。复制为 .env 并按需修改。
# 后端不自动加载 .env；本地开发可 `set -a; . ./.env; set +a`。

# HTTP 监听地址
AIOPS_ADDR=:8080

# 主库 DSN（必填）。日志中会脱敏。
AIOPS_DATABASE_URL=postgres://aiops:aiops@127.0.0.1:65432/aiops?sslmode=disable

# 32 字节主密钥的标准 base64；留空则使用 AIOPS_DATA_DIR/master.key
AIOPS_MASTER_KEY=

# 主密钥目录（运行时生成 master.key）
AIOPS_DATA_DIR=./data

# 仅首次创建 admin 时使用；留空则自动生成并打印一次
ADMIN_PASSWORD=

# 写请求 Origin 精确匹配列表
AIOPS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
AIOPS_PUBLIC_ORIGIN=http://localhost:8080

# 留空表示按 AIOPS_PUBLIC_ORIGIN 是否 https 自动判断
AIOPS_SECURE_COOKIES=

# 是否信任 X-Forwarded-For
AIOPS_TRUST_PROXY=false

# 生产静态文件目录；留空只提供 API
AIOPS_WEB_DIR=./web/dist

# debug | info | warn | error
AIOPS_LOG_LEVEL=info

AIOPS_SESSION_TTL=24h
AIOPS_APPROVAL_TTL=120s
AIOPS_STREAM_MAX_DURATION=30m
AIOPS_MAX_STREAMS=20

# 暴露 /debug/pprof（与 API 同鉴权；loadgen 采样依赖）
AIOPS_PPROF=false

# 测试库（go test 集成测试）；只允许 127.0.0.1/localhost:65432
TEST_DATABASE_URL=postgres://aiops:aiops@127.0.0.1:65432/aiops?sslmode=disable
# cmd/smoke 用同一连接参数，但强制使用独立库 aiops_smoke（每次运行结束删除）。
